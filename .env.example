
# === NanoClaw Configuration ===

# Bot identity
ASSISTANT_NAME=Andy
ASSISTANT_HAS_OWN_NUMBER=false

# Container settings
CONTAINER_IMAGE=nanoclaw-agent:latest
CONTAINER_TIMEOUT=1800000
IDLE_TIMEOUT=1800000
LOG_LEVEL=info

# === Agent Credentials ===
# One of the two options below must be set when NOT using Turnkey vault mode.
# In vault mode (see below) ANTHROPIC_API_KEY can be removed entirely.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# === Turnkey Credential & Sub-Org Management (optional) ===
#
# Architecture:
#
#   ┌──────────── Turnkey Root Org (NanoClaw operator) ─────────────┐
#   │  Service API key pair (set below)                             │
#   │  Optional: secp256k1 encryption key whose bytes act as        │
#   │  AES-256-GCM key for encrypting ANTHROPIC_API_KEY at rest     │
#   └────────────────────────┬──────────────────────────────────────┘
#                            │  createSubOrganization() on group register
#                            ▼
#   ┌────────── Turnkey Sub-Org per Agent Group ─────────────────────┐
#   │  HD Ethereum wallet (m/44'/60'/0'/0/0)                        │
#   │  Wallet address surfaced to agents via container stdin         │
#   │  Private key never leaves Turnkey HSM/TEE                     │
#   └────────────────────────────────────────────────────────────────┘
#
# Mode 1 — Auth-gate (set the three TURNKEY_* vars below):
#   Every container spawn authenticates with Turnkey, producing an immutable
#   audit record. ANTHROPIC_API_KEY still lives in this file but is cached
#   in memory with TTL and never re-read from disk within that window.
#   A sub-org with an Ethereum wallet is provisioned per agent group.
#
# Mode 2 — Full vault (set all six vars below):
#   ANTHROPIC_API_KEY is stored nowhere as plaintext. The encryption key's
#   raw bytes are exported from Turnkey via HPKE on each cache miss;
#   the local ciphertext is decrypted with AES-256-GCM, and the plaintext
#   key lives only in the in-memory cache for the duration of TTL.
#
# ── Step 1: Create a Turnkey account at app.turnkey.com ──────────────────────
#   Settings → API Keys → New API Key
#   Copy the organization ID, public key, and private key.
#
# TURNKEY_ORGANIZATION_ID=<your-org-uuid>
# TURNKEY_API_PUBLIC_KEY=<hex-encoded-p256-public-key>
# TURNKEY_API_PRIVATE_KEY=<hex-encoded-p256-private-key>
#
# Optional: override the in-memory credential TTL (default: 5 min)
# TURNKEY_TOKEN_TTL_MS=300000
#
# ── Step 2 (vault mode only): Store the LLM API key in Turnkey ───────────────
#   Run the one-time setup helper:
#
#     import { setupLlmKeyVault, getTurnkeyConfig } from './src/turnkey.js';
#     const config = getTurnkeyConfig();           // reads from .env
#     const { encryptionKeyId, encryptedKey } =
#       await setupLlmKeyVault(config, 'sk-ant-...');
#     console.log('TURNKEY_LLM_ENCRYPTION_KEY_ID=' + encryptionKeyId);
#     console.log('TURNKEY_LLM_ENCRYPTED_KEY=' + encryptedKey);
#
#   Then add the two values below and remove ANTHROPIC_API_KEY from .env.
#
# TURNKEY_LLM_ENCRYPTION_KEY_ID=<turnkey-private-key-id>
# TURNKEY_LLM_ENCRYPTED_KEY=<json-aes-gcm-bundle>
#
# ── Credential Proxy ─────────────────────────────────────────────────────────
#
# Two modes — selected automatically by which vars are set:
#
# Mode A — Local proxy (TURNKEY_* set, no TURNKEY_PROXY_URL):
#   NanoClaw starts an HTTP server on 127.0.0.1 (random port).
#   Containers receive a short-lived session token as ANTHROPIC_API_KEY
#   and ANTHROPIC_BASE_URL=http://host.docker.internal:{port}.
#   The proxy validates tokens, fetches the real key from Turnkey, injects it.
#   The real sk-ant-... key never enters the container's address space.
#   On Linux, --add-host host.docker.internal:host-gateway is added automatically.
#
# Mode B — TVC remote proxy (TURNKEY_PROXY_URL + TURNKEY_PROXY_ADMIN_TOKEN set):
#   Delegates to a pre-deployed Turnkey Verifiable Cloud app — a Nitro Enclave
#   running the proxy code from tvc-proxy/. The enclave's binary digest and
#   container image digest are cryptographically approved by the operator
#   manifest set, proving the exact code handling your API keys.
#
#   Containers receive ANTHROPIC_BASE_URL=https://app-<UUID>.turnkey.cloud.
#   NanoClaw registers each container's session token via POST /sessions and
#   revokes it via DELETE /sessions/:token when the container exits.
#   The real API key never leaves the Nitro Enclave.
#
#   To deploy the TVC proxy:
#     cd tvc-proxy
#     tvc login
#     tvc app create tvc-app.json.example   # one-time
#     ./scripts/build-and-digest.sh         # build image, compute digests
#     # edit tvc-deploy.json.example with the output digests
#     tvc deploy create tvc-deploy.json.example
#     tvc deploy approve --deploy-id <UUID> --operator-id <UUID>
#     # app becomes available at https://app-<UUID>.turnkey.cloud
#
# TURNKEY_PROXY_URL=https://app-<UUID>.turnkey.cloud
# TURNKEY_PROXY_ADMIN_TOKEN=<random-256-bit-secret-shared-with-tvc-app>
