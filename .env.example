
# === NanoClaw Configuration ===

# Bot identity
ASSISTANT_NAME=Andy
ASSISTANT_HAS_OWN_NUMBER=false

# Container settings
CONTAINER_IMAGE=nanoclaw-agent:latest
CONTAINER_TIMEOUT=1800000
IDLE_TIMEOUT=1800000
LOG_LEVEL=info

# === Agent Credentials (required) ===
# One of the two options below must be set.
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# === Turnkey Credential Management (optional) ===
# When all three TURNKEY_* vars are set, credential retrieval is routed through
# Turnkey's hardware-secured enclave instead of reading directly from this file.
#
# Benefits:
#  - Every credential access is authenticated and appears in Turnkey's immutable
#    audit log (HMAC-stamped request to api.turnkey.com).
#  - Credentials are cached in memory with a configurable TTL; the raw key is
#    never re-read from disk within the TTL window.
#  - TTL expiry enables zero-downtime key rotation: update ANTHROPIC_API_KEY
#    (or rotate it in Turnkey's vault) and agents pick up the new key after the
#    cache expires — no restart required.
#  - Each issuance event is also recorded in the local SQLite credential_audit_log
#    table for per-group compliance tracking.
#
# Setup:
#  1. Create an organisation at app.turnkey.com.
#  2. Generate an API key (Settings → API keys) — copy the public/private key pair.
#  3. Paste the three values below.
#
# TURNKEY_ORGANIZATION_ID=<your-org-uuid>
# TURNKEY_API_PUBLIC_KEY=<your-api-public-key>
# TURNKEY_API_PRIVATE_KEY=<your-api-private-key>
#
# Optional: override the in-memory credential TTL (default: 5 minutes = 300000 ms)
# TURNKEY_TOKEN_TTL_MS=300000
